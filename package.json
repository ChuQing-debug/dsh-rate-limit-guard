{
  "name": "dsh-rate-limit-guard",
  "version": "0.3.1",
  "description": "Wait out provider rate limits or rotate to another API key, with a settings UI and an event log.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChuQing-debug/dsh-rate-limit-guard.git"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "check": "node --check index.js && node --check lib.js && node --check client.js",
    "test": "node --test \"test/*.test.js\""
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "vendor",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
